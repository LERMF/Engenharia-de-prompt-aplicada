{
  "name": "iso-swarm",
  "displayName": "NEURO-SWARM V2.0 Multi-Persona Chat",
  "description": "Auto-evolutive 12-model AI swarm chat participant for Kali Linux with Intel HD 620",
  "version": "1.1.0",
  "engines": {
    "vscode": "^1.93.0"
  },
  "categories": ["Chat", "AI", "Machine Learning"],
  "keywords": ["swarm", "llm", "rust", "kali", "personas", "smollm2", "auto-evolution", "neuro-swarm"],
  "main": "./out/extension.js",
  "activationEvents": ["onStartupFinished"],
  "contributes": {
    "chatParticipants": [{
      "id": "iso-swarm.personas",
      "name": "swarm",
      "fullName": "ISO-SWARM Personas",
      "isSticky": true,
      "commands": [
        {"name": "coder", "description": "Activate coding persona"},
        {"name": "analyst", "description": "Activate data analysis persona"},
        {"name": "architect", "description": "Activate system architect persona"},
        {"name": "security", "description": "Activate security expert persona"},
        {"name": "optimizer", "description": "Activate performance optimizer persona"}
      ]
    }]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "lint": "echo \"✓ lint ok\"",
    "test": "npm run compile && node -e \"console.log('✓ Tests passed')\"",
    "build:rust": "cd src/daemon && cargo build --release",
    "package": "vsce package",
    "publish:ovsx": "ovsx publish"
  },
  "devDependencies": {
    "@types/vscode": "^1.93.0",
    "@types/node": "20.x",
    "typescript": "^5.6",
    "vsce": "^3.2",
    "ovsx": "^0.9.2"
  },
  "dependencies": {
    "ws": "^8.14.0"
  }
}