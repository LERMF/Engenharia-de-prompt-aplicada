{
  "name": "iso-swarm",
  "displayName": "ISO-SWARM Multi-Persona Chat",
  "description": "200 mini-LLMs swarm chat participant for Kali Linux 6.12.38 with Intel HD 620",
  "version": "1.0.0",
  "engines": {
    "vscode": "^1.93.0"
  },
  "categories": ["Chat", "AI", "Machine Learning"],
  "keywords": ["swarm", "llm", "rust", "kali", "personas"],
  "main": "./out/extension.js",
  "activationEvents": ["onStartupFinished"],
  "contributes": {
    "chatParticipants": [{
      "id": "iso-swarm.personas",
      "name": "swarm",
      "fullName": "ISO-SWARM Personas",
      "isSticky": true,
      "commands": [
        {"name": "coder", "description": "Activate coding persona"},
        {"name": "analyst", "description": "Activate data analysis persona"},
        {"name": "architect", "description": "Activate system architect persona"},
        {"name": "security", "description": "Activate security expert persona"},
        {"name": "optimizer", "description": "Activate performance optimizer persona"}
      ]
    }]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "build:rust": "cd src/daemon && cargo build --release",
    "package": "vsce package",
    "publish:ovsx": "ovsx publish"
  },
  "devDependencies": {
    "@types/vscode": "^1.93.0",
    "@types/node": "20.x",
    "typescript": "^5.6",
    "vsce": "^3.2",
    "ovsx": "^0.9.2"
  },
  "dependencies": {
    "ws": "^8.14.0"
  }
}