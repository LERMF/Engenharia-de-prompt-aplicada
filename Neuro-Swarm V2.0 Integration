Hot-Reload Implementation
rust
// src/daemon/hot_reload.rs
use notify::{Watcher, RecursiveMode, Result};
use std::sync::mpsc::channel;
use std::time::Duration;

pub struct HotReloader {
    watcher: RecommendedWatcher,
}

impl HotReloader {
    pub fn watch_models() -> Result<Self> {
        let (tx, rx) = channel();

        let mut watcher = notify::watcher(tx, Duration::from_secs(1))?;
        watcher.watch("./src/daemon/src", RecursiveMode::Recursive)?;

        std::thread::spawn(move || {
            loop {
                match rx.recv() {
                    Ok(event) => {
                        println!("🔥 Hot reload triggered!");
                        // Rebuild apenas o módulo alterado
                        std::process::Command::new("cargo")
                            .args(&["build", "--release"])
                            .output()
                            .expect("Rebuild failed");

                        // Notify daemon via SQL
                        let conn = rusqlite::Connection::open("swarm.db").unwrap();
                        conn.execute(
                            "INSERT INTO reload_queue (model_id, action) VALUES (?, ?)",
                            params!["all", "reload"]
                        ).unwrap();
                    },
                    Err(e) => eprintln!("Watch error: {:?}", e),
                }
            }
        });

        Ok(Self { watcher })
    }
}
