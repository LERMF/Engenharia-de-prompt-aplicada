}

impl QueryProfile {
    pub fn track<F, R>(label: &str, f: F) -> R
    where F: FnOnce() -> R
    {
        let start = Instant::now();
        let result = f();
        let elapsed = start.elapsed();

        // Auto-save to SQL
        save_profile(label, elapsed);

        if elapsed.as_millis() > 100 {
            warn!("⚠️  Slow query: {} took {}ms", label, elapsed.as_millis());
        }

        result
    }
}

